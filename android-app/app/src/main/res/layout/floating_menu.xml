<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_float"
    android:padding="12dp"
    android:elevation="8dp">

    <TextView
        android:id="@+id/tvFloatTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HCLOU MOD"
        android:textColor="#a78bfa"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnToggleBypass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toggle Bypass"
        android:textColor="#fff"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="@drawable/bg_btn_primary"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnCloseFloat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Close"
        android:textColor="#fca5a5"
        android:textSize="11sp"
        android:padding="6dp"
        android:background="@android:color/transparent" />

</LinearLayout>
