#--------------------------------------------------------------------
# HCLOU LICENSE PANEL — Cấu hình mẫu. Copy file này thành ".env" rồi sửa.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# URL gốc panel (phải có / cuối). VD nếu deploy ở thư mục con /public:
app.baseURL = 'https://your-domain.com/'

#--------------------------------------------------------------------
# DATABASE (sửa theo hosting của bạn)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = ten_database
database.default.username = user_db
database.default.password = mat_khau_db
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# CHỐNG CRACK /connect — RSA private key (base64 của PEM)
# Lấy ở panel: sidebar "License SDK" -> Tạo cặp khoá -> copy dòng vào .env THẬT.
# KHÔNG commit giá trị thật lên git (nhất là repo public). Để trống = dùng token cũ.
#--------------------------------------------------------------------
connect.rsaPrivate = ''
